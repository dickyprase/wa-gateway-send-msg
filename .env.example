# Server
PORT=3001

# JWT untuk dashboard web
JWT_SECRET=isi_random_string_minimal_32_karakter
JWT_EXPIRES_IN=24h

# Kredensial login dashboard
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=ganti_password_ini

# API Key — wajib disertakan helpdesk PHP di setiap request /api/send
WA_API_KEY=api_key_rahasia_untuk_helpdesk
